GATEWAY_PUBLIC_ORIGIN=https://flutter-widget-wallet-oauth-gateway-staging.onrender.com
AUTH0_ISSUER=https://YOUR_AUTH0_TENANT.auth0.com/
AUTH0_AUDIENCE=https://flutter-widget-wallet-oauth-gateway-staging.onrender.com/mcp
GATEWAY_ALLOWED_SUBJECTS=auth0|REPLACE_ME
GATEWAY_ALLOWED_CLIENT_IDS=REPLACE_WITH_GEMINI_CLIENT_ID
# Optional emergency denylist for JWT access-token IDs; comma-separated.
GATEWAY_REVOKED_JTIS=
GATEWAY_UPSTREAM_BEARER=SET_ONLY_IN_RENDER_SECRET_STORE
GATEWAY_UPSTREAM_URL=https://flutter-widget-wallet-mcp.onrender.com/mcp
GATEWAY_REQUIRED_SCOPE=mcp:read
GATEWAY_BODY_LIMIT_BYTES=1048576
GATEWAY_UPSTREAM_HEADER_TIMEOUT_MS=15000
GATEWAY_UPSTREAM_IDLE_TIMEOUT_MS=120000
GATEWAY_MAX_TOKEN_AGE_SECONDS=86400
GATEWAY_RATE_WINDOW_MS=60000
GATEWAY_RATE_PER_IDENTITY=120
GATEWAY_RATE_GLOBAL=600
GATEWAY_RATE_MAX_KEYS=10000
GATEWAY_SESSION_TTL_MS=3600000
GATEWAY_SESSION_MAX_ENTRIES=1000
GATEWAY_SESSION_MAX_PER_IDENTITY=20
# Empty means non-browser clients only. Add exact origins only after a verified browser requirement.
GATEWAY_ALLOWED_ORIGINS=
GATEWAY_TRUST_PROXY=true
